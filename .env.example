# Copiar a .env solo para uso local. Nunca publicar .env.
COMPOSE_PROJECT_NAME=agrostream

# Servicios expuestos en la laptop
API_HOST_PORT=8000
STREAMLIT_HOST_PORT=8501
KAFKA_UI_HOST_PORT=8081
MONGO_HOST_PORT=27017

# Kafka local en KRaft
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=agrostream-kraft-cluster-2026
KAFKA_LOG_LEVEL=INFO

# MongoDB local; cambiar en entornos reales
MONGO_INITDB_ROOT_USERNAME=agrostream_admin
MONGO_INITDB_ROOT_PASSWORD=agrostream_local_only
MONGO_DATABASE=agrostream
MONGO_URI=mongodb://agrostream_admin:agrostream_local_only@mongodb:27017/agrostream?authSource=admin

# Límites para proteger la laptop
MAX_BATCH_SIZE=10000
PRODUCER_COMPRESSION_TYPE=lz4
PRODUCER_LINGER_MS=10
PRODUCER_BATCH_SIZE=131072
CONSUMER_MINI_BATCH_SIZE=100
CONSUMER_POLL_TIMEOUT_SECONDS=1

# Política del dashboard
ALERT_RATE_MEDIUM_PERCENT=10
ALERT_RATE_HIGH_PERCENT=30
